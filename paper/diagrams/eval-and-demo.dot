// Evaluation protocol (locked) + the realistic-demo path
// Preview: Ctrl+Shift+P -> "Graphviz Interactive Preview: Preview Graphviz / Dot (beside)"
digraph eval_demo {
    rankdir=TB;
    graph [fontname="Segoe UI", fontsize=11, labelloc="t",
           label="Evaluation discipline + realistic demo (same checkpoint as the table)"];
    node  [shape=box, style="rounded,filled", fontname="Segoe UI", fontsize=10];
    edge  [fontname="Segoe UI", fontsize=9];

    subgraph cluster_splits {
        label="Official splits (never remixed)";
        style=filled; color="#eceff1"; fontname="Segoe UI Semibold";
        node [fillcolor="#cfd8dc"];
        train [label="train 23,384 (22,418 usable)\nall training + tokenizer"];
        val   [label="val 1,460\nmodel selection, sweeps - ONLY", fillcolor="#fff59d"];
        test  [label="test 4,384 (2,189 base usable)\ntouched ONCE per final table", fillcolor="#ffab91"];
    }

    subgraph cluster_evaluator {
        label="Guo et al. evaluator - reused UNMODIFIED";
        style=filled; color="#ede7f6"; fontname="Segoe UI Semibold";
        node [fillcolor="#b39ddb"];
        match [label="text_mot_match finest.tar\nmotion + text encoders (512-d space)\nGT repro: R@1 0.514 vs published 0.511"];
    }

    subgraph cluster_metrics {
        label="20-rep protocol (evaluate.py, run-manifest logged)";
        style=filled; color="#e1f5fe"; fontname="Segoe UI Semibold";
        node [fillcolor="#81d4fa"];
        m1 [label="FID (motion embeddings)"];
        m2 [label="R-precision @1/2/3 (32-pool)"];
        m3 [label="MM-Dist - Diversity"];
        m4 [label="MultiModality (100 caps x 30 gens)"];
        m5 [label="streaming bench: ms/step + state bytes\nvs horizon 64-1024"];
    }

    subgraph cluster_results {
        label="Anchors (2026-06-12)";
        style=filled; color="#fff3e0"; fontname="Segoe UI Semibold";
        node [fillcolor="#ffe0b2"];
        a1 [label="GT row: R@1 0.514"];
        a2 [label="tokenizer ceiling: recon-FID 0.0266"];
        a3 [label="twin v0: transformer 3.310 / mamba 3.928\n(1.19x, gate PASS)", fillcolor="#aed581"];
        a4 [label="published, cited:\nMoMask 0.045 - Mogo 0.079 - T2M-GPT 0.116"];
    }

    subgraph cluster_demo {
        label="Realistic demo (Phase 5) - SAME checkpoint as the table";
        style=filled; color="#fce4ec"; fontname="Segoe UI Semibold";
        node [fillcolor="#f8bbd0"];
        d1 [label="prompt box (aitviewer imgui)"];
        d2 [label="CLIP -> stream(cfg 5.0, stop_at_end)\ntokens appear incrementally"];
        d3 [label="frozen decoder -> 263 frames"];
        d4 [label="rot6d channels -> axis-angle -> SMPL-X pose\n(NO IK) + root from velocity channels"];
        d5 [label="slerp 20 -> 60 fps -> skinned mesh render\n+ cross-fade between prompts"];
        d1 -> d2 -> d3 -> d4 -> d5;
    }

    val   -> m1   [label="select best ckpt"];
    test  -> m1   [label="final table only"];
    match -> m1   [style=dashed];
    m1 -> a3; m2 -> a3; m4 -> a3;
    a3 -> d2 [label="one and the same weights", style=dashed, constraint=false];
}
