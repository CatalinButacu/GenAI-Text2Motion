# data & licensed assets -- never commit (290 GB donor corpus, SMPL-X bodies).
# Root-anchored: the unanchored `data/` silently ignored src/text2motion/data/ (found 2026-06-10).
/data/
/checkpoints/
/graphify-out/
/outputs/
*.zip
*.npz
*.pkl

# python
.venv/
__pycache__/
*.pyc
.pytest_cache/
.ruff_cache/
*.egg-info/

# caches
.cache/
/data/.cache/
.docker-cache/

# local container configuration; commit only the template
.env
.env.*
!.env.example

# Claude Code tooling -- local only (agents, skills, ADRs, hooks, settings)
.claude/

# editor
.vscode/
.idea/

# aitviewer window-layout cache (regenerated every run)
imgui.ini

# aws ssm scratch (command docs / ids)
_*.json
_cmdid.txt

