# Compose image/build
TEXT2MOTION_IMAGE=text2motion:local
TEXT2MOTION_DEV_IMAGE=text2motion:dev
TEXT2MOTION_CONFIG=configs/default.yaml
TEXT2MOTION_BIND_HOST=127.0.0.1
TEXT2MOTION_CONNECT_HOST=127.0.0.1
TEXT2MOTION_SERVICE_PORT=8765
TEXT2MOTION_IDLE_SECONDS=600
TEXT2MOTION_MEMORY_LIMIT=8g
TEXT2MOTION_SHM_SIZE=1g

# Container filesystem contract
TEXT2MOTION_DATASET_DIR=/app/data/HumanML3D_official
TEXT2MOTION_EVAL_MATCHER=/app/data/official_evaluator/extracted/t2m/text_mot_match/model/finest.tar
TEXT2MOTION_EVAL_STATS_DIR=/app/data/eval_stats
TEXT2MOTION_TEXTS_DIR=/app/data/HumanML3D_official/texts
TEXT2MOTION_SMPLX_MODELS=/app/data/smplx_models
TEXT2MOTION_CHECKPOINTS_DIR=/app/checkpoints
TEXT2MOTION_OUTPUTS_DIR=/app/outputs
TEXT2MOTION_LOGS_DIR=/app/logs
TEXT2MOTION_CACHE_DIR=/var/cache/text2motion

# Optional host-side bind mount roots. Keep licensed assets outside images.
TEXT2MOTION_HOST_DATA=./data
TEXT2MOTION_HOST_CHECKPOINTS=./checkpoints
TEXT2MOTION_HOST_OUTPUTS=./outputs
TEXT2MOTION_HOST_LOGS=./logs
TEXT2MOTION_HOST_CACHE=.docker-cache

# Model selection; override without editing Compose.
TEXT2MOTION_BACKBONE=transformer
TEXT2MOTION_GENERATOR_CHECKPOINT=/app/checkpoints/generator/generator_transformer_bs8_enc_last.pt
TEXT2MOTION_TOKENIZER_CHECKPOINT=/app/checkpoints/tokenizer/fsq_g8_v1024.pt
