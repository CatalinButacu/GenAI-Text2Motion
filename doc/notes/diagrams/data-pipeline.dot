// 01 - DATA PIPELINE (granular). One node = one transform. Color = which stage it belongs to.
// Preview: Ctrl+Shift+P -> "Graphviz Interactive Preview: Preview Graphviz / Dot (beside)"
digraph data_pipeline {
    rankdir=TB;
    graph [fontname="Segoe UI", fontsize=12, labelloc="t", label="01  Data pipeline: raw mocap to 263 features"];
    node  [shape=box, style="rounded,filled", fontname="Segoe UI", fontsize=10];
    edge  [fontname="Segoe UI", fontsize=9];

    subgraph cluster_raw {
        label="Donor AMASS (SMPL-X G release, read-only)";
        style=filled; color="#eceff1"; fontname="Segoe UI Semibold"; node [fillcolor="#cfd8dc"];
        npz    [label="load .npz sequence"];
        params [label="read 165-dim SMPL-X pose params"];
        rate   [label="read mocap_frame_rate (60-120 fps)"];
    }

    subgraph cluster_smplx {
        label="Stage 1 - raw_pose.py (SMPL-X forward, GPU)";
        style=filled; color="#e0f2f1"; fontname="Segoe UI Semibold"; node [fillcolor="#80cbc4"];
        layer   [label="build SMPL-X layer (neutral)"];
        downfps [label="downsample to 20 fps"];
        forward [label="forward kinematics to 3D joints"];
        keep22  [label="keep first 22 body joints"];
        zup     [label="convert Z-up to Y-up"];
        layer -> downfps -> forward -> keep22 -> zup;
    }

    subgraph cluster_canon {
        label="Stage 3 - feature.py process_file (per sequence)";
        style=filled; color="#fff8e1"; fontname="Segoe UI Semibold"; node [fillcolor="#ffe082"];
        uskel  [label="uniform_skeleton: retarget to template bone lengths"];
        floor  [label="put feet on the floor (y=0)"];
        origin [label="translate root to XZ origin at frame 0"];
        face   [label="rotate so initial facing is +Z"];
        cont6d [label="get_cont6d_params: per-joint 6D rotations"];
        rifke  [label="get_rifke: positions in root-invariant frame"];
        rootvel[label="root angular + linear velocity"];
        localv [label="local joint velocities"];
        foot   [label="foot_detect: heel/toe contact flags"];
        concat [label="concat to 263-dim frame vector"];
        uskel -> floor -> origin -> face;
        face -> cont6d; face -> rifke; face -> rootvel; face -> localv; face -> foot;
        cont6d -> concat; rifke -> concat; rootvel -> concat; localv -> concat; foot -> concat;
    }

    subgraph cluster_norm {
        label="Stage 4 - normalization (cal_mean_variance)";
        style=filled; color="#f1f8e9"; fontname="Segoe UI Semibold"; node [fillcolor="#aed581"];
        mean   [label="Mean.npy over all frames"];
        std    [label="Std.npy with per-group smoothing"];
        znorm  [label="normalize: (x - Mean) / Std"];
        mean -> znorm; std -> znorm;
    }

    subgraph cluster_two {
        label="Two corpora built from the same features";
        style=filled; color="#ede7f6"; fontname="Segoe UI Semibold"; node [fillcolor="#b39ddb"];
        citable [label="CITABLE: HumanML3D_official\n22,418 train clips + captions"];
        corpus  [label="PRETRAIN: AMASS_263\n13,249 sequences, val/test sources excluded"];
    }

    npz -> layer; params -> layer; rate -> downfps;
    zup -> uskel;
    concat -> mean; concat -> std; concat -> znorm;
    znorm -> citable; znorm -> corpus;
}
